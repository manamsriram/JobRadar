# Everything under data/ is runtime state except the five tracked seeds below.
# Deny-by-default on purpose: the old per-file list silently let new state
# files through, and company_contacts.json (recruiter names, verified email
# addresses) was one `git add -A` from being published.
data/*
!data/companies.json
!data/company_aliases.json
!data/funding_queue.json
!data/job_boards.json
!data/visa_sponsor_seeds.json

.DS_Store

# Claude Code local session state (the shared skills under .claude/skills are tracked)
.claude/settings.local.json
.claude/scheduled_tasks.lock
